# ==============================================================================
# Veda AI Backend - Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Application Settings
APP_NAME="Veda AI Backend API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veda_ai_db
POSTGRES_USER=veda_user
POSTGRES_PASSWORD=veda_password

# Asynchronous Database URL (Derived automatically if omitted)
DATABASE_URL=postgresql+asyncpg://veda_user:veda_password@localhost:5432/veda_ai_db

# Cross-Origin Resource Sharing (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_cryptographic_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_HOURS=1
COOKIE_SECURE=false

# Email Provider ('console' for local dev logging, 'smtp' for production)
EMAIL_PROVIDER=console
EMAILS_FROM_EMAIL=noreply@veda.ai

# Astrology Engine Configuration (Batch 6D-1)
ASTROLOGY_SYSTEM=vedic
ASTROLOGY_ZODIAC_TYPE=sidereal
ASTROLOGY_DEFAULT_AYANAMSHA=lahiri
ASTROLOGY_DEFAULT_HOUSE_SYSTEM=whole_sign
ASTROLOGY_NODE_TYPE=true
SWISS_EPHEMERIS_PATH=
ASTROLOGY_REQUIRE_EPHEMERIS_FILES=false
ASTROLOGY_ALLOW_APPROXIMATE_TIME=true

